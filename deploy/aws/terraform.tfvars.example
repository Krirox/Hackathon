# Copy to terraform.tfvars and fill in. Never commit real values.
region  = "eu-central-1"
project = "vital"

# Filled by the deploy workflow after `docker push` (ECR image URIs with :tag).
# Both must be non-empty: the busybox fallback was removed so a misconfigured
# apply cannot deploy a dead service. Repositories are created by the workflow
# (or by a targeted apply) before any image exists, so a local first apply is
# create-repos -> push -> apply. See docs/deployment.md.
# core_image     = "<account>.dkr.ecr.eu-central-1.amazonaws.com/vital-core:boot"
# executor_image = "<account>.dkr.ecr.eu-central-1.amazonaws.com/vital-executor:boot"
# Pilot: jcode sidecar off until ghcr.io/1jehuang/jcode is mirrored to ECR (private GHCR).
# jcode_sidecar_enabled = false
jcode_image    = "ghcr.io/1jehuang/jcode:v0.84.0"

desired_count     = 2
core_min_capacity = 2
core_max_capacity = 6
core_requests_per_target = 1000
# Staged jcode split: keep socket until the client learns TCP (see main.tf).
jcode_target        = "socket"
jcode_desired_count = 1
nat_per_az          = false
db_instance_class = "db.t4g.micro"
db_multi_az       = true
db_max_allocated_storage = 100

# All secrets via TF_VAR_* env in CI (see .github/workflows/deploy-aws.yml).
# Required, and deliberately NOT prefilled with a placeholder: an empty value or
# the literal "CHANGEME" fails validation, so a half-filled deploy stops before
# it ships a known HMAC/webhook secret or a dead model plane.
# tenant_hmac_secret = ""
# vital_core_secret  = ""
# webhook_secret     = ""
# serper_api_key     = ""
# bedrock_api_key      = ""   # TF_VAR_bedrock_api_key — Bedrock console → API keys
# Bedrock model IDs (Converse API). Enable each model in the account/region first.
# bedrock_prod_model_id = "zai.glm-4.7-flash"
# bedrock_dev_model_id  = "zai.glm-4.7-flash"
# Console mutation gate (empty = ungated dev only). Pilot: set via TF_VAR_operator_secret.
# operator_secret = "CHANGEME"
# Buzz agent identities + review tokens (empty = fail closed: no publishing identity, dead webhook approve path).
# buzz_agent_master_key via TF_VAR_buzz_agent_master_key (32+ hex chars)
# vital_review_secret via TF_VAR_vital_review_secret (random 16+ chars)
# Day-0 owner claiming (set once, claim, force-change password, then unset + re-apply to rotate).
# bootstrap_email = "owner@example.com"
# bootstrap_password via TF_VAR_bootstrap_password
# Deliberate web-claim authorization on non-loopback clients (empty = default gate).
# setup_secret via TF_VAR_setup_secret
# ALB HTTPS (empty = HTTP-forward dev only). Pilot: ACM cert ARN.
# acm_certificate_arn = ""
# ...or let Terraform create + validate the cert and name the host (dns.tf).
# The zone is looked up, never created. An explicit acm_certificate_arn wins if both are set.
# domain_name           = "console.example.com"
# hosted_zone_id        = "Z0123456789ABCDEFGHI"   # aws route53 list-hosted-zones
# subject_alternative_names = ["www.example.com"]  # must live in that same zone
# Private ALB posture (keep deployment private first — F01):
# alb_internal      = true
# alb_ingress_cidrs = ["10.0.0.0/16"]
# Ops alarm recipient (F27): an unsubscribed alarm topic alerts nobody.
# Set to a mailbox an operator actually reads, then CONFIRM the AWS
# subscription mail after apply — unconfirmed = formally firing, factually
# silent. Leave empty only for throwaway stacks.
# ops_alarm_email = "ops@example.test"

# Remote state (see commented backend block in main.tf): create the bucket +
# lock table once, then uncomment there and init with -backend-config flags
# (bucket, key, region, dynamodb_table). Until then, one machine, local state.

allowed_egress_hosts         = "api.serper.dev"
lambda_memory_mb             = 2048
lambda_reserved_concurrency  = 20

# Buzz relay (AWS-native — replaces deploy/docker-compose.buzz.yml MinIO/Redis path)
enable_buzz              = true
buzz_image               = "ghcr.io/block/buzz:main"
buzz_desired_count       = 2
buzz_db_instance_class   = "db.t4g.micro"
buzz_db_multi_az         = true
buzz_redis_node_type     = "cache.t4g.micro"
# buzz_relay_private_key via TF_VAR_buzz_relay_private_key (64-char hex secp256k1 key)
# Public relay hostname on the shared ALB (optional — internal Cloud Map always works):
# buzz_hostname = "buzz.example.com"
