# Copy to .env (never commit values). Names and descriptions only.
# Database (Vital core + Postgres live on VPS-2 in the reference topology)
DATABASE_URL=postgres://vital:CHANGEME@localhost:5432/vital
POSTGRES_DB=vital
POSTGRES_USER=vital
POSTGRES_PASSWORD=CHANGEME
# jcode sibling process: Unix socket (macOS/Linux) or named pipe (Windows)
JCODE_API_SOCKET=/run/jcode-api.sock
# Talk layer: buzz | slack-hmac (the fallback proven by the §0.4 spike)
TALK_SURFACE=buzz
# Per-tenant HMAC secret for the slack-hmac surface (see src/talk/surface.ts)
TENANT_HMAC_SECRET=CHANGEME
# Core secret minting scope tokens (see src/substrate/identity.ts)
VITAL_CORE_SECRET=CHANGEME
# Webhook intake shared secret (see src/substrate/scheduler.ts)
WEBHOOK_SECRET=CHANGEME
# Serper.dev key for web-search sensing (see src/ingest/collectors.ts).
# Read at the runtime boundary only: header, never stored, never logged.
SERPER_API_KEY=CHANGEME
# Model lanes (see src/substrate/models.ts): Gemini for dev, Novita + DeepSeek V4 for production.
# Use auth keys for Gemini (Google rejects standard keys since Sept 2026).
GEMINI_API_KEY=CHANGEME
GEMINI_MODEL=gemini-3.8-flash
NOVITA_API_KEY=CHANGEME
NOVITA_MODEL=deepseek/deepseek-v4
# Optional allow-lists (comma-separated; defaults are the pinned models above)
# APPROVED_DEV_MODELS=gemini-3.8-flash
# APPROVED_PROD_MODELS=deepseek/deepseek-v4
