# Copy to .env (never commit values). Names and descriptions only.
# Database (Vital core + Postgres live on VPS-2 in the reference topology)
DATABASE_URL=postgres://vital:CHANGEME@localhost:5432/vital
POSTGRES_DB=vital
POSTGRES_USER=vital
POSTGRES_PASSWORD=CHANGEME
# jcode sibling process: Unix socket (macOS/Linux) or named pipe (Windows)
JCODE_API_SOCKET=/run/jcode-api.sock
# Talk layer: buzz | slack-hmac (the fallback proven by the §0.4 spike)
TALK_SURFACE=buzz
# HTTP bind (AWS sets HOST=0.0.0.0 PORT=3100 in deploy/aws/main.tf; local keeps loopback)
HOST=127.0.0.1
PORT=3100
VITAL_TENANT=acme
# Operator secret gating console mutations (approve/decline/correct) via the
# x-vital-operator header. UNSET = anyone with network access may mutate:
# fine on loopback dev, never behind the ALB. Reads stay open either way.
# VITAL_OPERATOR_SECRET=CHANGEME
# Lambda only: skip schema migration at boot (the ECS core migrates; every
# Lambda boot running DDL is latency + contention). Requires the core to
# have booted at least once. Local/dev keeps the default (migrate).
# VITAL_MIGRATE_ON_BOOT=0
# Code-level egress allowlist (enforced by core + Lambda executor via decideEgress)
ALLOWED_EGRESS_HOSTS=api.novita.ai,generativelanguage.googleapis.com,api.serper.dev
# Per-tenant HMAC secret for the slack-hmac surface (see src/talk/surface.ts)
TENANT_HMAC_SECRET=CHANGEME
# Core secret minting scope tokens (see src/substrate/identity.ts)
VITAL_CORE_SECRET=CHANGEME
# First-run owner bootstrap for the console (see src/console/serve.ts):
# required only when `vital serve` starts against a tenant with no accounts.
# The owner is forced to change this password at first login.
VITAL_BOOTSTRAP_EMAIL=CHANGEME
VITAL_BOOTSTRAP_PASSWORD=CHANGEME
# Deliberate authorization for web organization claiming on non-loopback clients
# (or always, when set). Pass via `x-vital-setup` or the signup form field.
# VITAL_SETUP_SECRET=CHANGEME
# Webhook intake shared secret (see src/substrate/scheduler.ts)
WEBHOOK_SECRET=CHANGEME
# Serper.dev key for web-search sensing (see src/ingest/collectors.ts).
# Read at the runtime boundary only: header, never stored, never logged.
SERPER_API_KEY=CHANGEME
# Live meeting room TURN relay (see src/console/meetings.ts meetingIceServers).
# Without a TURN server, peers behind symmetric NATs cannot connect at all —
# the room shows a "relay unavailable" banner instead of a silent black tile.
# VITAL_TURN_URL=turn:turn.example.com:3478?transport=udp
# VITAL_TURN_USERNAME=CHANGEME
# VITAL_TURN_CREDENTIAL=CHANGEME
# Model lanes (see src/substrate/models.ts): Gemini for dev, Novita + DeepSeek V4 for production.
# Use auth keys for Gemini (Google rejects standard keys since Sept 2026).
GEMINI_API_KEY=CHANGEME
GEMINI_MODEL=gemini-3.8-flash
NOVITA_API_KEY=CHANGEME
NOVITA_MODEL=deepseek/deepseek-v4
# Optional allow-lists (comma-separated; defaults are the pinned models above)
# APPROVED_DEV_MODELS=gemini-3.8-flash
# APPROVED_PROD_MODELS=deepseek/deepseek-v4
